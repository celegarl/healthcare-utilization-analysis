            </zone>
            <zone forceUpdate='true' h='10375' id='13' type-v2='text' w='98400' x='800' y='80625'>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Key Findings: </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Patients aged 65+ had the highest utilization, averaging 93.55 encounters per patient.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Times New Roman' fontsize='12'>• Adults aged 50–64 accounted for the highest total volume with 1,533 encounters.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Times New Roman' fontsize='12'>• Ambulatory care represented 2,939 of 5,571 encounters (~53%), making it the most common encounter type.</run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
